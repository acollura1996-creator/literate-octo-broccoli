{
  "name": "heroes-and-empires-3d",
  "private": true,
  "version": "0.1.0",
  "description": "A browser-based 3D real-time strategy / hero game inspired by the Warcraft III custom map Heroes & Empires.",
  "type": "module",
  "scripts": {
    "dev": "npm run bake && vite",
    "dev:electron": "npm run bake && node scripts/dev-electron.mjs",
    "bake": "node tools/bake-models.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron",
    "build": "npm run bake && npm run typecheck && vite build && node scripts/build-electron.mjs",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "build:artifact": "npm run bake && vite build --mode artifact && node tools/build-artifact.mjs"
  },
  "devDependencies": {
    "@babylonjs/core": "^9.29.0",
    "@babylonjs/loaders": "^9.29.0",
    "@babylonjs/materials": "^9.29.0",
    "@fontsource/cinzel": "^5.3.0",
    "@types/node": "^22.20.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "three": "^0.186.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "main": "dist-electron/main.js",
  "author": "Heroes & Empires 3D",
  "build": {
    "appId": "com.heroesempires.game",
    "productName": "Heroes & Empires",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false,
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Heroes & Empires",
      "uninstallDisplayName": "Heroes & Empires",
      "artifactName": "Heroes-and-Empires-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "publish": null
  }
}
